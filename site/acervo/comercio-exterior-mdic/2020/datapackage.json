 "name": "comercio-exterior-mdic-2020",
 "title": "Comércio exterior (Comex Stat, MDIC) · 2020",
 "description": "Exportações e importações de bens do Brasil e de cada estado, por país de destino ou de origem: valor em dólares (US$ FOB) e peso líquido, por ano e por trimestre, desde 1997.",
 "version": "1.0.0",
 "periodo": "2020",
 "tipo_de_periodo": "ano",
 "inicio": "2020-01-01",
 "fim": "2020-12-31",
